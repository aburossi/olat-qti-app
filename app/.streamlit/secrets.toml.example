# Kopieren nach secrets.toml (liegt in .gitignore) und die Schlüssel eintragen.
# Auf Streamlit Cloud: denselben Inhalt unter App → Settings → Secrets einfügen.

[app]
# Adresse, unter der die App läuft — Rücksprungziel nach dem Microsoft-Login.
url = "http://localhost:8501"

[supabase]
# Dasselbe Projekt wie bbw-hko.ch (Konten, Microsoft-Login, Rollen).
url = "https://mbslkjxkleiudzsbjqau.supabase.co"
# Öffentlicher Schlüssel, wie PUBLIC_SUPABASE_ANON_KEY in dev/bbw-hko/.env — nie den service_role-Schlüssel.
anon_key = ""

[openai]
api_key = ""
# Modell wählt die Lehrperson in der App (gpt-5.6-luna oder gpt-4.1).
