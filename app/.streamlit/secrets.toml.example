# Lokal: nach secrets.toml kopieren (liegt in .gitignore) und ausfüllen.
# Streamlit Cloud: denselben Inhalt unter App → Settings → Secrets einfügen.

[supabase]
# Dasselbe Projekt wie bbw-hko.ch (Konten, Microsoft-Login, Rollen).
url = "https://mbslkjxkleiudzsbjqau.supabase.co"
# Öffentlicher Schlüssel, wie PUBLIC_SUPABASE_ANON_KEY in dev/bbw-hko/.env — nie den service_role-Schlüssel.
anon_key = ""

[openai]
api_key = ""
# Das Modell wählt die Lehrperson in der App (gpt-5.6-luna oder gpt-4.1).

# [app] ist optional: Die App erkennt ihre eigene Adresse selbst (lokal http://localhost:8501,
# auf Streamlit Cloud die App-Adresse). Nur eintragen, wenn das Rücksprungziel nach dem
# Microsoft-Login abweichen soll, z. B. hinter einem eigenen Domainnamen.
# [app]
# url = "https://olat-test.bbw.ch"

# Konten ausserhalb der bbw (Rolle «gast» in bbw-hko, dort ohne Lehrpersonen-Rechte), die diese App
# trotzdem nutzen dürfen. Anmeldung über «Mit E-Mail und Passwort». Konto legt eine Person mit
# Supabase-Zugang an, Rolle danach auf «gast» setzen — sonst ist es in bbw-hko eine Lehrperson.
[zugang]
gastkonten = ["test@olat.ch"]
